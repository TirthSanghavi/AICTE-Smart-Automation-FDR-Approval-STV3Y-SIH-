# Local synthetic-data demo only. Never commit real credentials or data.

# SQLite is used for the local prototype because no PostgreSQL server is
# available on the demo machine. Swap to a PostgreSQL URL + provider for deployment.
DATABASE_URL="file:./dev.db"

# 32+ random bytes. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string-before-any-shared-demo"

# Private document store (outside public/). Relative paths resolve from the project root.
FILE_STORE_PATH=".data/uploads"

OCR_ADAPTER="mock"
BANK_ADAPTER="simulated"
NOTIFY_ADAPTER="inapp"

# Demo mode enables synthetic banners, the demo clock and the alert scan button.
DEMO_MODE="true"
TEST_CLOCK_ENABLED="true"
